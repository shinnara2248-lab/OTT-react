{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/sports.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/sports/:operation", "destination": "/api/sports?operation=:operation" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
